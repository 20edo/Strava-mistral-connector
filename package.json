{
  "name": "strava-mistral-connector",
  "version": "0.2.0",
  "description": "Pull Strava activities and generate AI coaching insights with the Mistral API. Includes an MCP server for use as a Mistral Vibe connector.",
  "type": "module",
  "main": "dist/index.js",
  "scripts": {
    "build": "tsc",
    "start": "node dist/cli.js",
    "start:mcp": "RUN_MCP_SERVER=1 node dist/mcp-server.js",
    "test": "vitest run",
    "test:watch": "vitest"
  },
  "bin": { "strava-mistral": "dist/cli.js" },
  "keywords": ["strava", "mistral", "ai", "fitness", "connector", "mcp"],
  "license": "MIT",
  "devDependencies": {
    "typescript": "^5.6.0",
    "vitest": "^2.1.0",
    "@types/node": "^22.0.0"
  }
}
